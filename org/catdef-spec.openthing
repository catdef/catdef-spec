{
  "catdef": "1.4",
  "orgdef": "0.3.0",
  "type": "orgdef:Organization",
  "id": "catdef-spec",
  "name": "catdef Substrate Specification",
  "version": "1.0.0",

  "mission": "Define machine-enhanceable descriptors of real-world objects (OpenThing) and catalogs (OpenCatalog) in an open, machine-readable way that provides the substrate format on which the catdef-family consumer specs (roledef, orgdef, memodef) and any AI-readable structured-data application build.",

  "vision": "Part of the Open Agentic Governance Pattern (OAGP) family — alongside roledef, orgdef, and memodef — defining the substrate that the consumer specs use as their underlying machine-readable format. The primary readers of catdef artifacts are AI runtimes (rendering, validating, querying) and machine consumers (downstream tools, MCP-mediated agents); machine-readability and lossless-roundtrip-fidelity are the load-bearing constraints, not human readability.",

  "scope": "The catdef substrate schema (CATDEF_SPEC.md), the CATIO bundled-transport spec (CATIO_SPEC.md), the conformance test suite (164 tests), the canonical reference file (riverside-heritage-reference-v1.4.opencatalog), the MCP reference design (MCP_REFERENCE.md), the proposal/decision lineage (8 CA-NNN decisions plus i18n/MCP/theme decisions), and the L1 reference renderer at render.catdef.org. Out of scope: enforcing what consumers build on the substrate (content-neutral); runtime-specific implementations (specification only — anyone can build a renderer); the consumer-spec semantics layered on top of catdef (those belong to roledef, orgdef, memodef). Adjacent specs (Schema.org, JSON-LD, IPTC, EXIF) overlap in domain but differ in approach; out of scope for substrate-spec ownership.",

  "governance_model": "Bounded AI authority + human Director ratification + maintainer-via-feedback-channel discipline. The Chief Strategist (AI role with provisional bot identity catdef-strategist@catdef.org per CLAUDE.md known-work-items, ratification pending) sets strategic direction: triages proposals, files decisions in decisions/, makes pattern-promotion calls, and reviews submissions for the Director's final call. The catdef-maintainer (AI role with bot identity catdef-maintainer@catdef.org) drafts spec text, walks SCHEMA validations, and files decision artifacts per CLAUDE.md operating manual. The Director (Scott) reviews and ratifies; holds final tiebreaker authority on every merge, version bump, and governance change. Bounded-authority discipline applies uniformly: AI seats draft/decide/sign off, Director ratifies. Critical: implementations file feedback via catdef.org/feedback or the catdef_report_feedback MCP tool — never amend the spec mid-flight from a reference implementation. The feedback queue is the spec's input; the proposal-and-decision pipeline is its processing layer.",

  "values": [
    {
      "name": "openness",
      "description": "catdef is fundamentally open — a pattern, not a product. No vendor lock-in, no privileged implementer, no proprietary extensions in the core spec. All AI runtimes (Anthropic, OpenAI, xAI, Google, future) are equal citizens.",
      "rationale": "Adoption depends on equal-citizen treatment of all implementers; vendor capture would defeat the standard's purpose. Forks are welcome — anyone can publish their own catdef library at any URL using the same format."
    },
    {
      "name": "completeness",
      "description": "An OpenCatalog or OpenThing artifact MUST be sufficient that a fresh AI runtime loaded with the artifact can render, validate, or operate on it with zero context backfill.",
      "rationale": "Hallucination-prevention rule, not aesthetic preference. The primary reader is a machine; null context invites confabulation. A catdef artifact missing required structural content forces the AI to either guess or ask the user, which violates the zero-friction bar."
    },
    {
      "name": "L1 is sacred",
      "description": "A browser-only, no-server, file-reading renderer MUST remain a viable implementation of catdef. Proposals that require a server to be conformant at L1 are rejected. If the new capability genuinely needs a server, it lives at L2+.",
      "rationale": "The L1 conformance level guarantees catdef artifacts can be read by anyone with a web browser and a file. This is the floor that makes the spec accessible across deployment shapes; raising the floor would foreclose entire deployment environments (kiosks, offline use, embedded contexts)."
    },
    {
      "name": "extension-namespace-first",
      "description": "Before proposing a new core field, field type, setting, or attribute, ask: can this be expressed via x.<domain>.<identifier>? If yes, the feedback is redirected. The core spec stays lean on purpose. Promotion from extension to core happens only after cross-implementer demand is demonstrated.",
      "rationale": "The core spec is small by design; the extension namespace is large. Every core addition forecloses choice for other implementers; every extension preserves it. Promotion gates ensure additions earn their place by surviving multiple unrelated runtimes' adoption pressure."
    },
    {
      "name": "test-suite-as-standard",
      "description": "The conformance test suite IS the standard. A proposed change without proposed test coverage is incomplete. A proposal whose test coverage cannot be written is suspect — either the change isn't crisp enough to test, or it isn't behavioral enough to belong in the spec.",
      "rationale": "Prose specifications drift; tests are mechanically enforceable. Anyone can build a catdef renderer; to call it conformant, it must pass the test suite. This pattern means the spec's authority lives in machine-checkable artifacts, not in interpretation."
    },
    {
      "name": "forward-compatibility",
      "description": "Minor versions add optional fields; old catdefs remain valid; old runtimes gracefully ignore new fields. A proposal that breaks an existing v1.x catdef requires a major version bump and a migration story — and gets one only under duress.",
      "rationale": "Forward compatibility is the contract that makes adoption safe. Without it, every minor version adoption is a risk; with it, adoption is a free upgrade. The minor-version discipline preserves the asset value of historical catdefs."
    },
    {
      "name": "declarative-not-imperative",
      "description": "The spec says what, never how. Proposals that dictate implementation choices (specific databases, languages, wire protocols, storage layouts) are rejected or rewritten to express the what underneath.",
      "rationale": "Declarative specs survive runtime evolution; imperative specs die when the runtime changes. catdef will be implemented across runtime generations; coupling to any one runtime's architecture would foreclose the others."
    },
    {
      "name": "one-file-complete-product",
      "description": "A catdef contains everything needed to go from zero to running application: schema (templates, field definitions), data (items, values), and presentation (theme, settings) in one file. Proposals that split this — requiring external registries, online lookup services, or companion documents for basic rendering — are rejected.",
      "rationale": "Bundle-completeness is what makes catdef a portable contract. A renderer can take a catdef file and produce a working catalog; a viewer can take a catdef and render it; an AI can read a catdef and operate on it. Splitting the bundle would force every consumer to assemble pieces."
    },
    {
      "name": "human-readable",
      "description": "JSON with clear key names. A non-developer should be able to read a catdef and understand what their catalog will contain. Proposals that introduce opaque identifiers, binary blobs, or compressed representations in the core spec are rejected.",
      "rationale": "Human-readability is the on-ramp for non-developer participation. catdef is meant to be authored by people with spreadsheet skills, not just engineers. Compression or binary forms would foreclose that on-ramp without delivering substantial benefit at catdef's typical scales."
    },
    {
      "name": "policy-compliance-is-conformance",
      "description": "catdef is a policy-bearing standard. An author-declared policy (.machine-translate: \"Never\", or any future policy in the closed vocabulary) is not a suggestion to the runtime or tool — it is a constraint on conformant implementations. A runtime that silently ignores a policy is not a conformant catdef implementation.",
      "rationale": "Policies protect the trust contract between catdef authors and downstream consumers: authors declare intent, and the ecosystem is structurally required to honor it. Without this, policies are paper tigers; with it, authors can rely on their declarations being respected."
    }
  ],

  "red_lines": [
    {
      "rule": "No NULL-context catdef artifacts accepted by the spec, the conformance suite, or canonical authoring tooling.",
      "rationale": "Technical, not aesthetic — null context causes hallucination in the primary (machine) reader. The MUST-have-substantive-content rule is a hallucination-prevention rule, not a quality preference."
    },
    {
      "rule": "No content policing of consumers.",
      "rationale": "What organizations choose to build using catdef is their business, not the spec's. catdef governs the substrate's integrity, not the morality of its applications. Curation happens at the LIBRARY level (canonical inclusion), not the SPEC level."
    },
    {
      "rule": "Spec amendments MUST go through the feedback channel and proposal-and-decision pipeline. No in-flight amendment from any reference implementation, including those built by the same Claude-assisted human who maintains the spec.",
      "rationale": "When the spec-author and the primary-implementer are the same Claude-assisted human, in-flight spec drift can occur during implementation work. A change made quickly to meet an implementation's immediate need becomes, in effect, a unilateral spec amendment — exactly the anti-pattern this governance is meant to prevent. The feedback queue + proposal-and-decision pipeline is the correct path."
    },
    {
      "rule": "No major-version break without explicit Director sign-off and a migration story. Minor versions never break v1.x catdefs.",
      "rationale": "The forward-compatibility contract makes adoption safe. Major-version breaks invalidate that contract; they require explicit ratification (not delegated to the maintainer or strategist) and a clear path for existing catdefs to migrate."
    }
  ],

  "recommended_patterns": {
    "general": [
      {
        "pattern": "Senior strategist role separation",
        "description": "Specs SHOULD have a senior strategist role distinct from execution roles (maintainer, implementor), so each position stays in its lane.",
        "rationale": "Same reason developers shouldn't do their own security testing — bounded scope per role enables clean handoffs and prevents authority concentration."
      },
      {
        "pattern": "Two-section charter discipline",
        "description": "Organize orgdef content into two implicit sections: 'how this org operates' (mission, vision, values, governance, positions, relationships, red_lines) vs 'what we recommend for orgs using this pattern' (recommended_patterns). The two sections serve different audiences.",
        "rationale": "First section orients a reader joining this spec org; second section guides anyone deriving a new org from this one as a template. Conflating them muddles both audiences."
      },
      {
        "pattern": "Recursive self-describing v1 milestone",
        "description": "Treat 'this very orgdef exists as a valid, self-describing artifact in the org folder' as the spec's v1 success criterion.",
        "rationale": "If the pattern can't bootstrap its own author, it can't bootstrap anyone. Self-description is the most demanding test case for a standards project."
      },
      {
        "pattern": "Test-suite-as-standard",
        "description": "The conformance test suite IS the standard. Anyone can build a renderer; to call it conformant, it passes the suite.",
        "rationale": "Prose drifts; tests are mechanically enforceable. The suite is the authoritative artifact; spec text exists to explain the suite's intent."
      },
      {
        "pattern": "Extension-namespace-first",
        "description": "New capabilities live in x.<domain>.<identifier> first. Promotion to core happens only after cross-implementer demand is demonstrated (multiple unrelated runtimes converging on the same extension).",
        "rationale": "The core stays lean; the extension namespace is large. Promotion gates ensure additions earn their place by surviving multiple unrelated runtimes' adoption pressure. Same shape as the additive-only derivation discipline applied at the spec level."
      },
      {
        "pattern": "Writer-strict / reader-lenient (Postel's Law)",
        "description": "Writers MUST stamp the minimum version that defines every feature used. Readers gracefully ignore unrecognized fields.",
        "rationale": "This pattern enables forward compatibility: old catdefs survive runtime upgrades because writers were strict; new catdefs work on old runtimes because readers are lenient. Standard discipline borrowed from RFC 793 / Internet Robustness Principle."
      },
      {
        "pattern": "Feedback-channel-as-amendment-pipeline",
        "description": "Spec amendments arrive via catdef.org/feedback or the catdef_report_feedback MCP tool, are triaged by the catdef-maintainer per CLAUDE.md heuristics, and become proposals + decisions in the spec-text pipeline. No backdoor amendments.",
        "rationale": "Implementations, including reference implementations, are consumers. Treating them as such (vs giving them privileged amendment authority) keeps the spec from drifting toward any one implementation's needs."
      },
      {
        "pattern": "OAGP-family substrate-vs-consumer-spec layering",
        "description": "catdef is the substrate; consumer specs (roledef, orgdef, memodef, future xxxdef) build on it. Substrate decisions affect all consumers; consumer-spec decisions affect only that consumer.",
        "rationale": "The layering preserves modularity: catdef can evolve without dictating consumer-spec design; consumer specs can evolve without disrupting the substrate. Cross-spec coordination happens at the strategist level when needed."
      }
    ],
    "recommended_roles": [
      {
        "role": "human-director",
        "priority": "MUST",
        "why": "Bounded-authority discipline requires a human ratifier. catdef's specific governance shape places the Director at the apex with final authority on merges, version bumps, and governance changes."
      },
      {
        "role": {
          "id": "senior-open-standards-strategist",
          "version": "1.0.0",
          "url": "https://roledef.org/roledefs/senior-open-standards-strategist.openthing"
        },
        "priority": "MUST",
        "why": "Library-curation, scope-narrowing, pattern-promotion calls. catdef's Chief Strategist seat is held by the AI-strategist session arc (provisional bot identity catdef-strategist@catdef.org per CLAUDE.md known-work-items pending ratification); the Director reviews and depends on this seat for submission review and recommendations."
      },
      {
        "role": "catdef-maintainer",
        "priority": "MUST",
        "why": "Drafts spec text, walks SCHEMA validations, files decision artifacts. catdef's maintainer has a defined bot identity (catdef-maintainer@catdef.org) per CLAUDE.md and a substantial accumulated body of work (8 CA-NNN decisions, 164 conformance tests, the v1.4 release)."
      },
      {
        "role": "canonical-implementor",
        "priority": "SHOULD",
        "why": "Reference renderers and validators are how the spec gets dogfooded. catdef's canonical-implementor maintains render.catdef.org's L1 reference renderer (Worker code, /fetch SSRF proxy, namespaced-type handling) per the catdef.org PR sequence."
      },
      {
        "role": "reference-implementor",
        "priority": "SHOULD",
        "why": "Maintains canonical reference data (riverside-heritage-reference-v1.4.opencatalog) and builds reference implementations like the planned MCP server. Distinct from canonical-implementor; reference-implementor focuses on canonical data + MCP, canonical-implementor focuses on rendering + Worker code."
      }
    ]
  },

  "v1_success_criterion": "v1 has already been achieved. catdef shipped v1.4 (April 2026) with 164 conformance tests, a canonical reference file (riverside-heritage-reference-v1.4.opencatalog) demonstrating structural correctness end-to-end, an operational L1 reference renderer at render.catdef.org, and 8 CA-NNN decisions forming a stable governance trail. The OAGP-family bootstrap (roledef, orgdef, memodef built on catdef without requiring substrate changes) confirms the substrate-shape was correct empirically. Forward evolution happens via the proposal-and-decision pipeline; major v2 deliverables (filter query grammar, permissions model, MIME-type registration) are tracked in CLAUDE.md known-work-items but do not gate v1 recognition. Per the Director's call: 'The catdef organization has already achieved v1 success.'",

  "positions": [
    {
      "id": "director",
      "name": "Director",
      "description": "Human Director (Scott / scottconfusedgorilla) with final tiebreaker authority on every merge, version bump, governance decision, and strategic direction. The Director reviews submissions and ratifies the Chief Strategist's recommendations; depends on the Chief Strategist for first-pass review and proposal triage. Bounded-authority discipline: Director ratifies, Chief Strategist drafts/decides/signs off. No role_definition (humans are not derived from roledefs)."
    },
    {
      "id": "chief-strategist",
      "name": "Chief Strategist",
      "description": "AI role with provisional bot identity catdef-strategist@catdef.org (ratification pending per CLAUDE.md known-work-items: 'the Chief Strategist role does not have a [ratified] bot identity; strategist-authored artifacts in decisions/ are provisionally attributed to catdef-strategist@catdef.org pending ratification'). The seat is held by the AI-strategist session arc, NOT by the Director — the bounded-authority discipline applies uniformly. The Chief Strategist triages proposals against catdef's values-that-don't-move and CLAUDE.md triage heuristics, files decision artifacts in decisions/, makes pattern-promotion calls (extension→core, MAY→SHOULD, SHOULD→MUST), and reviews submissions for the Director's final call. The Director trusts and depends on this seat for submission review and recommendations; final calls are the Director's. References to 'steward' in some catdef-spec materials refer to this seat. No published roledef yet; eventual derivation from senior-open-standards-strategist is a forward work item."
    },
    {
      "id": "catdef-maintainer",
      "name": "catdef Maintainer",
      "description": "AI role with bot identity catdef-maintainer@catdef.org. Drafts CATDEF_SPEC.md / CATIO_SPEC.md / MCP_REFERENCE.md edits, walks SCHEMA validations, files decision artifacts in decisions/, drafts conformance tests for proposed changes. Operates per CLAUDE.md operating manual; bounded-authority discipline (drafts/decides/signs off; does not merge, deploy, or unilaterally amend). No role_definition currently; eventual self-extraction as a roledef is a forward work item."
    },
    {
      "id": "canonical-implementor",
      "name": "Canonical Implementor",
      "description": "AI role responsible for catdef-substrate canonical implementation: render.catdef.org L1 reference renderer, the /fetch SSRF-guarded proxy, catdef-family namespaced-type rendering, MCP-tool integration patterns. Operates from the catdef.org repo (separate from catdef-spec). Has shipped catdef.org PRs #1-#5 in the bootstrap arc. Steady-state focus is catdef-substrate concerns; bootstrap-era cross-spec scaffolding (e.g., contributions to roledef-spec / orgdef-spec / memodef-spec patterns) was transitional — going forward, sibling specs maintain their own canonical-implementors per the role-vs-job-distinction discipline. No role_definition currently; eventual self-extraction is a forward work item.",
      "x.position.lifecycle": "operational-with-bootstrap-era-shared-scaffolding-history; steady-state going forward is catdef-substrate-only"
    },
    {
      "id": "reference-implementor",
      "name": "Reference Implementor",
      "description": "AI role responsible for catdef canonical reference data (riverside-heritage-reference-v1.4.opencatalog and successors) and reference implementations like the planned MCP server. Distinct from canonical-implementor: reference-implementor focuses on canonical data + MCP server work; canonical-implementor focuses on rendering + Worker code. Currently vacant (the planned MCP server is upcoming work; canonical reference data is maintained as needed by the Director directly). No role_definition currently."
    }
  ],

  "relationships": [
    {
      "type": "reports_to",
      "from": "chief-strategist",
      "to": "director",
      "description": "Chief Strategist (AI session arc) drafts strategic direction, files decisions, and signs off on submissions; Director (Scott, human) reviews and ratifies merges / version-bumps / governance-changes. Bounded-authority discipline mirrors the maintainer/director and canonical-implementor/director relationships."
    },
    {
      "type": "reports_to",
      "from": "catdef-maintainer",
      "to": "director",
      "description": "Maintainer drafts spec text and decisions; Director merges. Bot-identity-vs-Director boundary is the bounded-authority discipline."
    },
    {
      "type": "reports_to",
      "from": "canonical-implementor",
      "to": "director",
      "description": "Implementor drafts code (catdef.org PRs); Director merges and deploys. Bounded-authority discipline mirroring the maintainer relationship."
    },
    {
      "type": "reports_to",
      "from": "reference-implementor",
      "to": "director",
      "description": "Reference-implementor maintains canonical reference data and reference implementations; Director merges. (Currently vacant; relationship structurally specified for when staffed.)"
    },
    {
      "type": "directs",
      "from": "chief-strategist",
      "to": "catdef-maintainer",
      "description": "Strategist sets direction (proposal triage, build directives in decisions/); maintainer drafts spec text and conformance tests in support."
    },
    {
      "type": "directs",
      "from": "chief-strategist",
      "to": "canonical-implementor",
      "description": "Strategist sets direction for canonical tooling priorities (renderer features, /fetch behavior, namespaced-type handling); implementor builds."
    },
    {
      "type": "directs",
      "from": "chief-strategist",
      "to": "reference-implementor",
      "description": "Strategist sets direction for canonical reference data + reference implementations; reference-implementor builds."
    },
    {
      "type": "coordinates_with",
      "from": "chief-strategist",
      "to": "external:roledef-strategist",
      "description": "Cross-spec coordination: when roledef needs substrate-level catdef changes (e.g., new field types, new format conventions), catdef-strategist holds substrate-side authority. Per the OAGP-family substrate-vs-consumer layering pattern. Bidirectional informational coordination; substrate decisions take priority over consumer preferences."
    },
    {
      "type": "coordinates_with",
      "from": "chief-strategist",
      "to": "external:orgdef-strategist",
      "description": "Same substrate-vs-consumer coordination shape, applied to orgdef's substrate-level needs (e.g., orgdef:Organization type registered with catdef substrate)."
    },
    {
      "type": "coordinates_with",
      "from": "chief-strategist",
      "to": "external:memodef-strategist",
      "description": "Same substrate-vs-consumer coordination shape, applied to memodef's substrate-level needs (e.g., memodef:Memo type registered with catdef substrate)."
    }
  ],

  "metadata": {
    "kind": "operational",
    "derived_from": {
      "id": "oagp-family-open-standard",
      "version": "1.0.0",
      "url": "https://orgdef.org/canonical-orgs/oagp-family-open-standard.openthing"
    },
    "authors": [
      "catdef-strategist <catdef-strategist@catdef.org>"
    ],
    "license": "MIT",
    "created": "2026-04-27",
    "extracted_from": "Self-extraction by the catdef-spec strategist seat (currently held by the Director per CLAUDE.md), facilitated by org-creation-facilitator role in high-context mode. Source materials: CATDEF_SPEC.md (the substrate spec itself, v1.4), CATIO_SPEC.md (bundled-transport companion), CLAUDE.md (the maintainer-and-strategist operating manual including the 9 values-that-don't-move list), CONTRIBUTING.md (governance and feedback-channel discipline), README.md (high-level framing), MCP_REFERENCE.md (AI-agent integration design), the conformance test suite (164 tests across CA-001 through CA-007 plus i18n/MCP/theme decisions), the canonical reference file (riverside-heritage-reference-v1.4.opencatalog), the catdef.org PR sequence (PRs #1-#5 in the bootstrap arc, including catdef-canonical-implementor's transitional cross-spec scaffolding work visible in the roledef-spec/memos/2026-04-27-0125 PR #5 rundown memo), the strategist memory file at strategist-memory/project_catdef_strategist_role.md, and the recent commit history (v1.4 release in April 2026 plus the strategist-memory portability commit). Field-by-field provenance audit per the established EXTRACTED / FRAMING / FORMALIZATION / OUT-OF-SCOPE pattern: EXTRACTED — the 9 values-that-don't-move from CLAUDE.md (lifted verbatim with rationale; value #2 'Implementations don't own the spec' subsumed under canonical openness rather than added as separate value); the 8+ CA-NNN decisions' enumerated count from decisions/; the conformance-test-suite-as-standard pattern from CLAUDE.md+README; the writer-strict version-stamping pattern from CA-002; the maintainer-via-feedback-channel discipline from CLAUDE.md; the substrate-vs-consumer-spec layering pattern from the OAGP-family bootstrap empirics; the v1.4-shipped + 164-tests + canonical-reference + L1-renderer maturity facts from README and recent commits. FRAMING — the 'catdef as substrate, neither bootstrap-shaped nor coordinative' positioning is empirically novel (third derivation against the canonical, after memodef's coordinative observation and roledef's bootstrap-shape confirmation); the Chief-Strategist-held-by-AI-session-arc framing (provisional bot identity catdef-strategist@catdef.org per CLAUDE.md known-work-items, ratification pending) corrects an initial dual-incumbent assumption that surfaced during read-back — the Director reviews and ratifies, the Chief Strategist (AI) drafts/recommends/signs off, bounded-authority discipline applies uniformly across maintainer/canonical-implementor/strategist seats; the canonical-implementor's steady-state-vs-bootstrap-era-shared-scaffolding distinction is articulated explicitly per roledef-strategist's experience-memo finding #6. FORMALIZATION — the relationship typing applies orgdef's standard set (reports_to / directs / coordinates_with) to catdef's role-relationships; the cross-org coordinates_with edges to external:roledef-strategist / external:orgdef-strategist / external:memodef-strategist use the v0.3-deferred informal placeholder convention pending structured cross-org reference shape (M3 of charter-shape-additions decision); the x.position.lifecycle marker on canonical-implementor anticipates roledef-strategist's experience-memo finding (proposed structured-marker for transitional-shared positions). OUT-OF-SCOPE — runtime-specific implementation details (deferred to per-runtime documentation); spec-evolution forward-roadmap items (filter query grammar, permissions model, MIME-type registration are tracked in CLAUDE.md known-work-items but do not appear in the orgdef itself); cross-org reference structured shape (deferred to orgdef v0.3 per the existing decision). The Director-elicited v1_success_criterion takes the Gordian-knot retrospective shape (per roledef-spec precedent) — empirically the third spec to hit v1 framing, with catdef being the only one of the three that genuinely sits at v1.x maturity (v1.4 shipped, 164 tests, canonical reference, operational renderer) versus orgdef-spec's still-developing self-description and roledef-spec's just-completed coordinated rollout.",
    "homepage": "https://catdef.org/orgs/catdef-spec",
    "repository": "https://github.com/catdef/catdef-spec/blob/main/org/catdef-spec.openthing",
    "history": [
      {
        "version": "1.0.0",
        "date": "2026-04-27",
        "change": "Initial derivation from oagp-family-open-standard v1.0.0. Third operational derivation against the canonical template (after memodef-spec and roledef-spec, both of which produced experience memos that this derivation builds on). Empirical novelty: catdef is the third structural category for the canonical's mission template (substrate, distinct from bootstrap-shaped orgdef/roledef and coordinative memodef) — confirms memodef-strategist's finding #1 that the canonical mission shape needs three example shapes, not two. Slot fills cite catdef's accumulated maturity (v1.4 shipped April 2026, 164 conformance tests, canonical reference file, L1 reference renderer at render.catdef.org, 8+ CA-NNN decisions). v1_success_criterion takes Gordian-knot retrospective shape per the Director's call ('the catdef organization has already achieved v1 success'). Cross-spec coordination edges (external:roledef-strategist / external:orgdef-strategist / external:memodef-strategist) use the v0.3-deferred placeholder convention pending structured cross-org reference shape. Adds x.position.lifecycle marker on canonical-implementor per roledef-strategist's experience-memo finding (transitional-shared bootstrap-era scaffolding distinguished from steady-state operational focus). Read-back surfaced one Director correction: the initial dual-incumbent framing for Director/Chief-Strategist was wrong — Chief Strategist seat is held by the AI-strategist session arc (provisional bot identity catdef-strategist@catdef.org pending ratification), Director reviews and ratifies; bounded-authority discipline applies uniformly. Revision applied in batch before scaffold."
      }
    ]
  }
}
